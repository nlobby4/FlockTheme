{
  "manifest_version": 3,
  "name": "FlockMod Themer",
  "version": "1.6.6",
  "description": "The ultimate customization tool for Flockmod. Have fun!",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flockmod.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "style.css"
      ],
      "matches": [
        "https://flockmod.com/*"
      ]
    }
  ]
}
